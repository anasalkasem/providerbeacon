# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=
RUN_DATABASE_MIGRATIONS=false

# Explicit preview fixtures; ignored in production. Defaults to an empty/unavailable catalogue.

# Independent staff authentication and encrypted provider credentials.
# See docs/SECURITY_AND_SYNC.md for key generation and first-owner setup.
VAULT_MASTER_KEY=
AUTH_PEPPER=
AUTH_BOOTSTRAP_TOKEN=

# Public Beacon AI. Keep the API key on the server; never prefix it with VITE_.
# Adding OPENAI_API_KEY enables real chat. Set BEACON_AI_ENABLED=false to pause it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
BEACON_AI_ENABLED=true
# Global turns/day across replicas; at most two model requests per turn.
BEACON_AI_DAILY_LIMIT=500
