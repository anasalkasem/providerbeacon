# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=
RUN_DATABASE_MIGRATIONS=false

# Explicit preview fixtures; ignored in production. Defaults to an empty/unavailable catalogue.

# Independent staff authentication and encrypted provider credentials.
# See docs/SECURITY_AND_SYNC.md for key generation and first-owner setup.
VAULT_MASTER_KEY=
AUTH_PEPPER=
AUTH_BOOTSTRAP_TOKEN=
